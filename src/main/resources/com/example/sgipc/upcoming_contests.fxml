<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="400.0" spacing="15" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sgipc.UpcomingContestController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <children>
            <Button onAction="#handleBack" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #f0f0f0; -fx-cursor: hand; -fx-border-color: #ccc; -fx-border-radius: 5;" text="← Back">
                <font>
                    <Font name="System Bold" size="13.0" />
                </font>
            </Button>
            <Label style="-fx-text-fill: #a009bc;" text="Upcoming Contests">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>
        </children>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="contestContainer" spacing="15" style="-fx-padding: 10;">
            </VBox>
        </content>
    </ScrollPane>

    <Button fx:id="addContestButton" managed="false" maxWidth="Infinity" onAction="#openAddContestWindow" prefHeight="45.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-cursor: hand;" text="+ Add New Contest" visible="false">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Button>
</VBox>